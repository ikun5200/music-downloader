# ===== 必填 =====
# 后台登录用户名
ADMIN_USERNAME=admin
# 后台登录密码（首次启动后仍可修改此变量并重启）
ADMIN_PASSWORD=change-me-please
# 会话签名密钥，执行 openssl rand -hex 32 生成
AUTH_SECRET=CHANGE_ME

# ===== 下载与存储 =====
# 容器内下载目录，docker-compose 会挂载宿主机音乐目录到这里
DOWNLOAD_DIR=/downloads
# 界面上展示的宿主机路径，与 docker-compose 的 volumes 左侧保持一致
HOST_DOWNLOAD_DIR=/vol1/1000/音乐
# SQLite 数据库（容器内路径，无需修改）
DATABASE_URL=file:/app/data/app.db?connection_limit=1&socket_timeout=30
# 手机/电脑访问本站的地址，用于生成洛雪自定义源脚本
PUBLIC_BASE_URL=http://192.168.1.10:3000
# 最大并发下载数
MAX_CONCURRENT_DOWNLOADS=2
# 时区
TZ=Asia/Shanghai

# ===== Docker 运行用户 =====
# 与 NAS 上拥有音乐目录的用户/用户组保持一致，通常为 1000
PUID=1000
PGID=1000
# 对外端口
APP_PORT=3000
